{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "palewire-mastodon-well-known-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "startup-canary": {
      "name": "palewire-mastodon-well-known-proxy-startup-canary",
      "workers_dev": true,
      "preview_urls": true
    },
    "same-zone-canary": {
      "name": "palewire-mastodon-well-known-proxy-same-zone-canary",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "CANARY_PATH": "/.well-known/cloudflare-worker-canary"
      }
    }
  }
}
