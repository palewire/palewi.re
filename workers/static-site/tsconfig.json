{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "ESNext.Disposable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "cloudflare.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    ".cloudflare/types"
  ]
}
